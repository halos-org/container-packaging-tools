[Unit]
Description=Provisioning for {{ package.human_name }}
# Provisioning lives in its own unit so that neither its failures nor its
# runtime count against {{ package.name }}.service's start limit. Long or
# failing setup work therefore cannot drive the app unit into a permanent
# `failed` state, which is what happens when the same work runs in the app's
# blocking ExecStartPre.
After=docker.service
Requires=docker.service
# docker.service being active says nothing about DNS or a default route, so a
# device with working internet can otherwise lose the boot race and look
# indistinguishable from a genuinely offline one.
Wants=network-online.target
After=network-online.target
# Nothing here restarts, so there is nothing to rate-limit. Inheriting systemd's
# default would let a crash-looping app exhaust this unit's start limit, after
# which starts are refused -- silently, because the app only Wants= this unit.
StartLimitIntervalSec=0

[Service]
# Deliberately no Restart= and no RemainAfterExit=: the retry is simply the next
# app start, and returning to inactive on completion is what lets that happen.
Type=oneshot
WorkingDirectory={{ service.working_directory }}
# The app's prestart has not run yet, so runtime.env does not exist. Only the
# app's own config is available here.
EnvironmentFile=-{{ service.env_defaults_file }}
EnvironmentFile=-{{ service.env_file }}
# The hook must name any container it runs after this variable, so the cleanup
# below can reap it. A start-timeout kills this unit's whole cgroup and takes
# the hook's own cleanup with it; ExecStopPost still runs, and a container
# started by dockerd would otherwise outlive the unit and keep writing.
Environment=HALOS_PROVISION_CONTAINER={{ package.name }}-provision
ExecStart={{ service.working_directory }}/provision.sh
ExecStopPost=-docker rm -f {{ package.name }}-provision
# Outer stop-loss only: the hook enforces its own wall-clock budget. This bounds
# how long a hung hook can delay the app, since the app's start job waits here.
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
